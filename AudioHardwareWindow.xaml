<Window x:Class="WellenEditor.AudioHardwareWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Audio-Hardware" Width="570" Height="420" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" FontFamily="Tahoma" FontSize="11" Background="#FFC0C0C0">
  <Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="Audio-Hardwarezuordnung" FontWeight="Bold" FontSize="13" Margin="2,0,0,10"/>
    <Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="20"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <TextBlock Text="Wiedergabe" FontWeight="Bold"/><Grid Grid.Row="1" Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Ausgabegerät:" VerticalAlignment="Center"/><ComboBox x:Name="OutputDeviceBox" Grid.Column="1" MinWidth="350" DisplayMemberPath="Name"/></Grid>
      <TextBlock Grid.Row="3" Text="Aufnahme" FontWeight="Bold"/><Grid Grid.Row="4" Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Eingabegerät:" VerticalAlignment="Center"/><ComboBox x:Name="InputDeviceBox" Grid.Column="1" DisplayMemberPath="Name"/></Grid>
      <TextBlock Grid.Row="5" Margin="0,18,0,0" TextWrapping="Wrap" Foreground="#FF404040">Die Liste zeigt die aktiven Windows-Audioendpunkte. Das gewählte Ausgabegerät wird für die Wiedergabe verwendet. Das Eingabegerät ist für die Aufnahmezuordnung hinterlegt.</TextBlock>
    </Grid>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Width="85" Margin="4" IsDefault="True" Click="Ok_Click">OK</Button><Button Width="85" Margin="4" IsCancel="True">Abbrechen</Button></StackPanel>
  </Grid>
</Window>
