<Window x:Class="WellenEditor.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:WellenEditor" Title="WaveBench Pro – Edit View" Width="1280" Height="790" MinWidth="920" MinHeight="600" Background="#FFC0C0C0" Foreground="#FF101010" FontFamily="Tahoma" FontSize="11" PreviewKeyDown="MainWindow_PreviewKeyDown">
  <Window.Resources>
    <Style x:Key="ClassicButton" TargetType="Button"><Setter Property="Background" Value="#FFC0C0C0"/><Setter Property="BorderBrush" Value="#FF808080"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="7,3"/><Setter Property="Margin" Value="2"/><Setter Property="FontFamily" Value="Tahoma"/><Setter Property="FontSize" Value="11"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"><Border BorderBrush="#FFFFFFFF" BorderThickness="1" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Border><ControlTemplate.Triggers><Trigger Property="IsPressed" Value="True"><Setter Property="BorderBrush" Value="#FF404040"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource ClassicButton}"><Setter Property="Width" Value="29"/><Setter Property="Height" Value="27"/><Setter Property="Padding" Value="1"/><Setter Property="FontFamily" Value="Segoe UI Symbol"/><Setter Property="FontSize" Value="15"/></Style>
    <Style TargetType="Menu"><Setter Property="Background" Value="#FFC0C0C0"/><Setter Property="FontFamily" Value="Tahoma"/></Style>
    <Style TargetType="MenuItem"><Setter Property="FontFamily" Value="Tahoma"/><Setter Property="FontSize" Value="11"/><Setter Property="Padding" Value="8,3"/></Style>
    <Style x:Key="PanelCaption" TargetType="TextBlock"><Setter Property="Foreground" Value="#FFFFFFFF"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="6,0"/></Style>
  </Window.Resources>
  <DockPanel LastChildFill="True">
    <Border DockPanel.Dock="Top" Background="#FFC0C0C0" BorderBrush="#FF808080" BorderThickness="0,0,0,1"><Menu>
      <MenuItem Header="_Datei"><MenuItem Header="Öffnen..." InputGestureText="Strg+O" Click="Open_Click"/><MenuItem Header="Speichern unter..." InputGestureText="Strg+Umschalt+S" Click="Save_Click"/><Separator/><MenuItem Header="Beenden" Click="Exit_Click"/></MenuItem>
      <MenuItem Header="_Bearbeiten"><MenuItem Header="Rückgängig" InputGestureText="Strg+Z" Click="Undo_Click"/><MenuItem Header="Wiederholen" InputGestureText="Strg+Y" Click="Redo_Click"/><Separator/><MenuItem Header="Ausschneiden" InputGestureText="Strg+X" Click="Cut_Click"/><MenuItem Header="Kopieren" InputGestureText="Strg+C" Click="Copy_Click"/><MenuItem Header="Einfügen" InputGestureText="Strg+V" Click="Paste_Click"/><MenuItem Header="Löschen" InputGestureText="Entf" Click="Delete_Click"/><Separator/><MenuItem Header="Alles auswählen" InputGestureText="Strg+A" Click="SelectAll_Click"/></MenuItem>
      <MenuItem Header="_Ansicht"><MenuItem Header="Horizontal vergrößern" InputGestureText="+" Click="ZoomIn_Click"/><MenuItem Header="Horizontal verkleinern" InputGestureText="-" Click="ZoomOut_Click"/><MenuItem Header="Vertikal vergrößern" Click="ZoomVerticalIn_Click"/><MenuItem Header="Vertikal verkleinern" Click="ZoomVerticalOut_Click"/><MenuItem Header="Gesamte Datei" InputGestureText="Strg+0" Click="ShowAll_Click"/></MenuItem>
      <MenuItem Header="_Effekte"><MenuItem Header="Amplitude"><MenuItem Header="Normalisieren..." Click="Normalize_Click"/><MenuItem Header="Einblenden" Click="FadeIn_Click"/><MenuItem Header="Ausblenden" Click="FadeOut_Click"/></MenuItem><MenuItem Header="Filter" IsEnabled="False"/><MenuItem Header="Rauschminderung" IsEnabled="False"/></MenuItem>
      <MenuItem Header="_Aufnahme"><MenuItem Header="Aufnahme starten/stoppen" InputGestureText="Strg+R" Click="Record_Click"/></MenuItem>
      <MenuItem Header="_Erzeugen" IsEnabled="False"/><MenuItem Header="_Analyse" IsEnabled="False"/><MenuItem Header="_Favoriten" IsEnabled="False"/>
      <MenuItem Header="_Optionen"><MenuItem Header="Audio-Hardware..." Click="AudioHardware_Click"/></MenuItem>
      <MenuItem Header="_Fenster" IsEnabled="False"/><MenuItem Header="_Hilfe"><MenuItem Header="Info zu WaveBench Pro" Click="About_Click"/></MenuItem>
    </Menu></Border>
    <Border DockPanel.Dock="Top" Background="#FFC0C0C0" BorderBrush="#FF808080" BorderThickness="0,0,0,1" Padding="3,2"><StackPanel Orientation="Horizontal">
      <Button Style="{StaticResource ToolButton}" Content="▱" ToolTip="Öffnen" Click="Open_Click"/><Button Style="{StaticResource ToolButton}" Content="▣" ToolTip="Speichern unter" Click="Save_Click"/><Rectangle Width="1" Height="22" Fill="#FF808080" Margin="5,1"/><Button Style="{StaticResource ToolButton}" Content="↶" ToolTip="Rückgängig (Strg+Z)" Click="Undo_Click"/><Button Style="{StaticResource ToolButton}" Content="↷" ToolTip="Wiederholen (Strg+Y)" Click="Redo_Click"/><Button Style="{StaticResource ToolButton}" Content="✂" ToolTip="Ausschneiden" Click="Cut_Click"/><Button Style="{StaticResource ToolButton}" Content="⧉" ToolTip="Kopieren" Click="Copy_Click"/><Button Style="{StaticResource ToolButton}" Content="▣" ToolTip="Einfügen" Click="Paste_Click"/><Button Style="{StaticResource ToolButton}" Content="⌫" ToolTip="Auswahl löschen" Click="Delete_Click"/><Rectangle Width="1" Height="22" Fill="#FF808080" Margin="5,1"/><Button Style="{StaticResource ToolButton}" Content="▶" ToolTip="Wiedergabe" Click="Play_Click"/><Button Style="{StaticResource ToolButton}" Content="■" ToolTip="Stopp" Click="Stop_Click"/><Button x:Name="RecordButton" Style="{StaticResource ToolButton}" Content="●" ToolTip="Aufnahme starten/stoppen (Strg+R)" Click="Record_Click"/><Rectangle Width="1" Height="22" Fill="#FF808080" Margin="5,1"/><Button Style="{StaticResource ToolButton}" Content="H−" ToolTip="Horizontal verkleinern" Click="ZoomOut_Click"/><Button Style="{StaticResource ToolButton}" Content="H+" ToolTip="Horizontal vergrößern" Click="ZoomIn_Click"/><Button Style="{StaticResource ToolButton}" Content="V−" ToolTip="Vertikal verkleinern" Click="ZoomVerticalOut_Click"/><Button Style="{StaticResource ToolButton}" Content="V+" ToolTip="Vertikal vergrößern" Click="ZoomVerticalIn_Click"/>
    </StackPanel></Border>
    <Border DockPanel.Dock="Top" Background="#FFC0C0C0" Padding="5,4" BorderBrush="#FF808080" BorderThickness="0,0,0,1"><StackPanel Orientation="Horizontal"><Button Style="{StaticResource ClassicButton}" FontWeight="Bold" Content="Edit View" Padding="14,4"/><Button Style="{StaticResource ClassicButton}" Content="Multitrack View" Padding="14,4" IsEnabled="False"/><TextBlock x:Name="FileNameText" Margin="16,0,0,0" VerticalAlignment="Center" FontWeight="Bold" Text="Untitled"/></StackPanel></Border>
    <StatusBar DockPanel.Dock="Bottom" Background="#FFC0C0C0" BorderBrush="#FF808080" BorderThickness="1,1,0,0" FontFamily="Tahoma"><StatusBarItem x:Name="HintText" Width="300">Bereit</StatusBarItem><Separator/><StatusBarItem x:Name="StartText" Width="145">Start: 0:00.000</StatusBarItem><StatusBarItem x:Name="EndText" Width="145">Ende: 0:00.000</StatusBarItem><StatusBarItem x:Name="SelectionText" Width="145">Auswahl: 0:00.000</StatusBarItem><Separator/><StatusBarItem x:Name="LevelText" Width="82">Pegel: —</StatusBarItem><ProgressBar x:Name="LevelMeter" Width="90" Height="12" Minimum="-60" Maximum="0" Value="-60"/><Separator/><StatusBarItem x:Name="SampleText" Width="230">Samples: 0 – 0 (0)</StatusBarItem></StatusBar>
    <Grid Margin="5"><Grid.ColumnDefinitions><ColumnDefinition Width="218"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" BorderBrush="#FF606060" BorderThickness="1" Background="#FFE2E2E2"><DockPanel><Border DockPanel.Dock="Top" Height="23" Background="#FF1E4F81" BorderBrush="#FF103763" BorderThickness="0,0,0,1"><TextBlock Style="{StaticResource PanelCaption}" Text="Organizer"/></Border><TabControl Margin="4" Background="#FFE2E2E2" BorderBrush="#FF808080"><TabItem Header="Dateien"><DockPanel Margin="3"><StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,5"><Button Style="{StaticResource ClassicButton}" Content="Öffnen" Click="Open_Click"/></StackPanel><ListBox x:Name="FileList" BorderBrush="#FF808080" Background="#FFFFFFFF" SelectionChanged="FileList_SelectionChanged"><ListBoxItem Foreground="#FF777777">Keine Datei geöffnet</ListBoxItem></ListBox></DockPanel></TabItem><TabItem Header="Effekte"><ListBox Margin="3" Background="#FFFFFFFF" BorderBrush="#FF808080"><ListBoxItem>Amplitude</ListBoxItem><ListBoxItem>Filter</ListBoxItem><ListBoxItem>Delay Effects</ListBoxItem><ListBoxItem>Noise Reduction</ListBoxItem></ListBox></TabItem><TabItem Header="Favoriten"><TextBlock Margin="8" TextWrapping="Wrap">Eigene Schnellbefehle erscheinen hier.</TextBlock></TabItem></TabControl><Border DockPanel.Dock="Bottom" Background="#FFC0C0C0" BorderBrush="#FF808080" BorderThickness="0,1,0,0" Padding="6"><StackPanel><TextBlock x:Name="FormatText" Text="Audioformat: —"/><TextBlock x:Name="DurationText" Margin="0,3,0,0" Text="Länge: —"/></StackPanel></Border></DockPanel></Border>
      <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#FFC0C0C0"/>
      <Border Grid.Column="2" BorderBrush="#FF404040" BorderThickness="1" Background="#FF102725" ClipToBounds="True"><DockPanel LastChildFill="True"><Border DockPanel.Dock="Top" Height="25" Background="#FF19433E" BorderBrush="#FF51857C" BorderThickness="0,0,0,1"><Grid><TextBlock Text="Waveform Display" Foreground="#FFD1E6DE" Margin="8,0" VerticalAlignment="Center"/><TextBlock x:Name="ViewRangeText" Foreground="#FF93BEB1" HorizontalAlignment="Right" Margin="8,0" VerticalAlignment="Center"/></Grid></Border><local:WaveformView x:Name="Waveform" SelectionChanged="Waveform_SelectionChanged"/></DockPanel></Border>
    </Grid>
  </DockPanel>
</Window>
