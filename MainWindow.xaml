<Window x:Class="WellenEditor.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:WellenEditor" Title="WaveBench Pro – Edit View" Width="1280" Height="790" MinWidth="920" MinHeight="600" Background="{StaticResource Surface}" Foreground="{StaticResource Text}" FontFamily="Segoe UI" FontSize="12" PreviewKeyDown="MainWindow_PreviewKeyDown">
  <Window.Resources>
    <Style x:Key="ClassicButton" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource Raised}"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="9,4"/>
      <Setter Property="Margin" Value="2"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentDark}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource ClassicButton}">
      <Setter Property="Width" Value="29"/>
      <Setter Property="Height" Value="27"/>
      <Setter Property="Padding" Value="1"/>
      <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
      <Setter Property="FontSize" Value="15"/>
    </Style>
    <Style x:Key="LoopToolButton" TargetType="ToggleButton">
      <Setter Property="Width" Value="29"/><Setter Property="Height" Value="27"/><Setter Property="Padding" Value="1"/><Setter Property="Margin" Value="2"/>
      <Setter Property="Background" Value="{StaticResource Raised}"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontFamily" Value="Segoe UI Symbol"/><Setter Property="FontSize" Value="15"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover}"/><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentDark}"/><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style TargetType="Menu">
          <Setter Property="Background" Value="{StaticResource Panel}"/>
          <Setter Property="Foreground" Value="{StaticResource Text}"/>
          <Setter Property="BorderThickness" Value="0"/>
          <Setter Property="FontFamily" Value="Segoe UI"/>
          <Setter Property="FontSize" Value="13"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="Menu">
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="4,2">
                  <ItemsPresenter KeyboardNavigation.TabNavigation="Cycle" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                </Border>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>

    <Style TargetType="MenuItem">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="MinHeight" Value="26"/>
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" SnapsToDevicePixels="True">
              <Grid SnapsToDevicePixels="True">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="IconColumn" Grid.Column="0" Width="28">
                  <Grid>
                    <TextBlock x:Name="CheckMark" Text="✓" FontSize="14" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                    <ContentPresenter x:Name="IconContent" ContentSource="Icon" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Grid>
                </Border>

                <ContentPresenter x:Name="HeaderHost" Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" Margin="8,0,6,0"/>

                <TextBlock x:Name="GestureText" Grid.Column="2" Text="{TemplateBinding InputGestureText}" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="24,0,0,0"/>

                <Path x:Name="Arrow" Grid.Column="3" Data="M0,0 L4,4 L0,8" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0,4,0" Visibility="Collapsed"/>

                <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsSubmenuOpen}" Placement="Bottom" HorizontalOffset="-1" PopupAnimation="Fade">
                  <Border x:Name="SubMenuBorder" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Padding="4" SnapsToDevicePixels="True">
                    <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.TabNavigation="Cycle" Grid.IsSharedSizeScope="True"/>
                  </Border>
                </Popup>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="Role" Value="TopLevelHeader">
                <Setter TargetName="IconColumn" Property="Width" Value="0"/>
                <Setter TargetName="HeaderHost" Property="Margin" Value="0,0,4,0"/>
                <Setter TargetName="PART_Popup" Property="HorizontalOffset" Value="0"/>
              </Trigger>
              <Trigger Property="Role" Value="TopLevelItem">
                <Setter TargetName="IconColumn" Property="Width" Value="0"/>
                <Setter TargetName="HeaderHost" Property="Margin" Value="0,0,4,0"/>
              </Trigger>
              <Trigger Property="Role" Value="SubmenuHeader">
                <Setter TargetName="PART_Popup" Property="Placement" Value="Right"/>
                <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Line}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#FF6B7785"/>
                <Setter TargetName="GestureText" Property="Foreground" Value="#FF58636D"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ContextMenu">
      <Setter Property="Background" Value="{StaticResource Panel}"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="4"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContextMenu">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ItemsPresenter KeyboardNavigation.TabNavigation="Cycle" Grid.IsSharedSizeScope="True"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
      <Setter Property="Background" Value="{StaticResource Line}"/>
      <Setter Property="Margin" Value="6,3"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Separator">
            <Border Height="1" Background="{TemplateBinding Background}" SnapsToDevicePixels="True"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Separator">
      <Setter Property="Background" Value="{StaticResource Line}"/>
      <Setter Property="Margin" Value="6,2"/>
    </Style>

    <Style TargetType="ToolTip">
      <Setter Property="Background" Value="{StaticResource Panel}"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToolTip">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="8,5" SnapsToDevicePixels="True">
              <ContentPresenter/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TabControl">
      <Setter Property="Background" Value="{StaticResource Panel}"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}">
              <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource Text}"/></Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ListBox">
      <Setter Property="Background" Value="{StaticResource WaveSurface}"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Padding" Value="6,3"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="2" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover}"/></Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentDark}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="StatusBar">
      <Setter Property="Background" Value="{StaticResource Panel}"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
    </Style>
    <Style TargetType="StatusBarItem">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
    </Style>

    <Style x:Key="PanelCaption" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="8,0"/>
    </Style>

    <ContextMenu x:Key="WaveformContextMenu">
      <MenuItem Header="Neu aus Auswahl" Click="NewFromSelection_Click"/>
      <Separator/>
      <MenuItem Header="Kopieren" Click="Copy_Click"/>
      <MenuItem Header="Ausschneiden" Click="Cut_Click"/>
      <MenuItem Header="Löschen" Click="Delete_Click"/>
    </ContextMenu>

    <Style x:Key="TabSelectButton" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource Raised}"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="10,3"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource Hover}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsActive}" Value="True">
          <Setter Property="Background" Value="{StaticResource Accent}"/>
          <Setter Property="Foreground" Value="{StaticResource Surface}"/>
          <Setter Property="FontWeight" Value="SemiBold"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ViewTabActiveButton" TargetType="Button" BasedOn="{StaticResource TabSelectButton}">
      <Setter Property="Background" Value="{StaticResource Accent}"/>
      <Setter Property="Foreground" Value="{StaticResource Surface}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="16,4"/>
    </Style>
    <Style x:Key="TabCloseButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="5,3"/>
      <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#FF6E3A3A"/><Setter Property="Foreground" Value="{StaticResource Text}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <DockPanel LastChildFill="True">
    <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"><Menu>
      <MenuItem Header="_Datei"><MenuItem Header="Neu aus Auswahl" Click="NewFromSelection_Click"/><MenuItem Header="Öffnen..." Click="Open_Click"/><Separator/><MenuItem Header="Speichern" Click="Save_Click"/><MenuItem Header="Speichern unter..." Click="SaveAs_Click"/><MenuItem Header="Exportieren..." Click="Export_Click"/><Separator/><MenuItem Header="Schließen" Click="CloseDocument_Click"/><MenuItem Header="Beenden" Click="Exit_Click"/></MenuItem>
      <MenuItem Header="_Bearbeiten"><MenuItem Header="Rückgängig" Click="Undo_Click"/><MenuItem Header="Wiederholen" Click="Redo_Click"/><Separator/><MenuItem Header="Ausschneiden" Click="Cut_Click"/><MenuItem Header="Kopieren" Click="Copy_Click"/><MenuItem Header="Einfügen" Click="Paste_Click"/><MenuItem Header="Löschen" Click="Delete_Click"/><Separator/><MenuItem Header="Auswahl präzise setzen..." Click="PreciseSelection_Click"/><MenuItem Header="Alles auswählen" Click="SelectAll_Click"/></MenuItem>
      <MenuItem Header="_Ansicht"><MenuItem Header="Horizontal vergrößern" Click="ZoomIn_Click"/><MenuItem Header="Horizontal verkleinern" Click="ZoomOut_Click"/><MenuItem Header="Vertikal vergrößern" Click="ZoomVerticalIn_Click"/><MenuItem Header="Vertikal verkleinern" Click="ZoomVerticalOut_Click"/><MenuItem Header="Gesamte Datei" Click="ShowAll_Click"/><Separator/><MenuItem x:Name="SpectrogramMenuItem" Header="Spektrogramm" IsCheckable="True" Click="SpectrogramToggle_Click"/><MenuItem x:Name="MeterMenuItem" Header="Stereo-Pegelanzeige" IsCheckable="True" IsChecked="True" Click="MeterToggle_Click"/></MenuItem>
      <MenuItem Header="_Effekte"><MenuItem Header="Amplitude"><MenuItem Header="Verstärken..." Click="Gain_Click"/><MenuItem Header="Normalisieren..." Click="Normalize_Click"/><MenuItem Header="Einblenden" Click="FadeIn_Click"/><MenuItem Header="Ausblenden" Click="FadeOut_Click"/></MenuItem><MenuItem Header="Filter"><MenuItem Header="Hochpass..." Click="HighPass_Click"/><MenuItem Header="Tiefpass..." Click="LowPass_Click"/><MenuItem Header="Equalizer..." Click="Equalizer_Click"/></MenuItem><MenuItem Header="Dynamik"><MenuItem Header="Kompressor..." Click="Compressor_Click"/><MenuItem Header="Peak-Clipper..." Click="Limiter_Click"/></MenuItem><MenuItem Header="Rauschminderung" IsEnabled="False"/><Separator/><MenuItem Header="VST3-Effekte neu scannen" Click="ScanVst_Click"/></MenuItem>
      <MenuItem Header="_Aufnahme"><MenuItem Header="Aufnahme starten/stoppen" Click="Record_Click"/></MenuItem>
      <MenuItem Header="_Analyse"><MenuItem Header="Spektrogramm anzeigen" IsCheckable="True" IsChecked="{Binding IsChecked, ElementName=SpectrogramMenuItem, Mode=TwoWay}" Click="SpectrogramToggle_Click"/><MenuItem Header="Pegelanzeige anzeigen" IsCheckable="True" IsChecked="{Binding IsChecked, ElementName=MeterMenuItem, Mode=TwoWay}" Click="MeterToggle_Click"/></MenuItem>
      <MenuItem Header="_Optionen"><MenuItem Header="Audio-Hardware..." Click="AudioHardware_Click"/>
        <MenuItem x:Name="BlockPlaybackMenuItem" Header="Mehrspur: neue Wiedergabe (experimentell)" IsCheckable="True" Click="BlockPlaybackToggle_Click"/>
        <MenuItem Header="Mehrspur-Wiedergabepuffer">
          <MenuItem Header="4 Blöcke" Tag="4" Click="BlockBuffer_Click"/>
          <MenuItem Header="8 Blöcke (Standard)" Tag="8" Click="BlockBuffer_Click"/>
          <MenuItem Header="16 Blöcke" Tag="16" Click="BlockBuffer_Click"/>
        </MenuItem>
      </MenuItem>
      <MenuItem Header="_Fenster" IsEnabled="False"/><MenuItem Header="_Hilfe"><MenuItem Header="Info zu WaveBench Pro" Click="About_Click"/></MenuItem>
    </Menu></Border>

    <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="4,3">
      <StackPanel Orientation="Horizontal">
        <Button Style="{StaticResource ToolButton}" Content="▱" ToolTip="Öffnen" Click="Open_Click"/><Button Style="{StaticResource ToolButton}" Content="▣" ToolTip="Speichern unter" Click="SaveAs_Click"/><Button Style="{StaticResource ToolButton}" Content="⇩" ToolTip="Exportieren (Strg+E)" Click="Export_Click"/><Rectangle Width="1" Height="22" Fill="{StaticResource Line}" Margin="5,1"/><Button Style="{StaticResource ToolButton}" Content="↶" ToolTip="Rückgängig (Strg+Z)" Click="Undo_Click"/><Button Style="{StaticResource ToolButton}" Content="↷" ToolTip="Wiederholen (Strg+Y)" Click="Redo_Click"/><Button Style="{StaticResource ToolButton}" Content="✂" ToolTip="Ausschneiden" Click="Cut_Click"/><Button Style="{StaticResource ToolButton}" Content="⧉" ToolTip="Kopieren" Click="Copy_Click"/><Button Style="{StaticResource ToolButton}" Content="▣" ToolTip="Einfügen" Click="Paste_Click"/><Button Style="{StaticResource ToolButton}" Content="⌫" ToolTip="Auswahl löschen" Click="Delete_Click"/><Rectangle Width="1" Height="22" Fill="{StaticResource Line}" Margin="5,1"/><Button Style="{StaticResource ToolButton}" Content="▶" ToolTip="Wiedergabe" Click="Play_Click"/><Button Style="{StaticResource ToolButton}" Content="■" ToolTip="Stopp" Click="Stop_Click"/><ToggleButton x:Name="LoopButton" Style="{StaticResource LoopToolButton}" Content="⟳" ToolTip="Endlosschleife ein/aus" Click="LoopToggle_Click"/><Button x:Name="RecordButton" Style="{StaticResource ToolButton}" Content="●" ToolTip="Aufnahme starten/stoppen (Strg+R)" Click="Record_Click"/>
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Top" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="6,4">
      <StackPanel Orientation="Horizontal"><Button x:Name="EditViewButton" Style="{StaticResource ViewTabActiveButton}" Content="Edit View" Click="EditView_Click"/><Button x:Name="MultitrackViewButton" Style="{StaticResource TabSelectButton}" Content="Multitrack View" Click="MultitrackView_Click"/></StackPanel>
    </Border>

    <StatusBar DockPanel.Dock="Bottom" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1,1,0,0" FontFamily="Segoe UI">
      <StatusBarItem x:Name="HintText" Width="300">Bereit</StatusBarItem><Separator/><StatusBarItem x:Name="StartText" Width="145" ToolTip="Anfang des markierten Bereichs">Start: —</StatusBarItem><StatusBarItem x:Name="EndText" Width="145" ToolTip="Ende des markierten Bereichs">Ende: —</StatusBarItem><StatusBarItem x:Name="SelectionText" Width="145" ToolTip="Länge des markierten Bereichs: Ende minus Start">Dauer: —</StatusBarItem><Separator/><StatusBarItem x:Name="SampleText" Width="230">Keine Auswahl</StatusBarItem>
    </StatusBar>
    <Border x:Name="MeterPanel" DockPanel.Dock="Bottom" Background="{StaticResource WaveSurface}" Padding="6,4,6,2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"><local:StereoLevelMeter x:Name="StereoMeter" Height="82"/></Border>

    <Grid Margin="6">
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="218"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Grid.RowSpan="2" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="{StaticResource Panel}">
        <DockPanel>
          <Border DockPanel.Dock="Top" Height="25" Background="{StaticResource AccentDark}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"><TextBlock Style="{StaticResource PanelCaption}" Text="Organizer"/></Border>
          <TabControl Margin="4" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}">
            <TabItem Header="Dateien"><DockPanel Margin="3"><StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,5"><Button Style="{StaticResource ClassicButton}" Content="Öffnen" Click="Open_Click"/><Button Style="{StaticResource ClassicButton}" Content="−" Margin="4,0,0,0" MinWidth="28" Click="FileListRemove_Click" ToolTip="Dokument schließen"/></StackPanel><ListBox x:Name="FileList" SelectionChanged="FileList_SelectionChanged" PreviewMouseLeftButtonDown="FileList_PreviewMouseLeftButtonDown" PreviewMouseMove="FileList_PreviewMouseMove"><ListBoxItem Foreground="{StaticResource Muted}">Keine Datei geöffnet</ListBoxItem></ListBox></DockPanel></TabItem>
            <TabItem Header="Effekte"><DockPanel Margin="3"><StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,5"><Button Style="{StaticResource ClassicButton}" Content="VST3 scannen" Click="ScanVst_Click"/></StackPanel><ListBox x:Name="VstEffectsList" DisplayMemberPath="DisplayName" MouseDoubleClick="VstEffectsList_MouseDoubleClick"><ListBoxItem Foreground="{StaticResource Muted}">Noch nicht gescannt</ListBoxItem></ListBox></DockPanel></TabItem>
            <TabItem Header="Favoriten"><TextBlock Margin="8" TextWrapping="Wrap" Foreground="{StaticResource Muted}">Eigene Schnellbefehle erscheinen hier.</TextBlock></TabItem>
          </TabControl>
          <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="8"><StackPanel><TextBlock x:Name="FormatText" Text="Audioformat: —" Foreground="{StaticResource Muted}"/><TextBlock x:Name="DurationText" Margin="0,3,0,0" Text="Länge: —" Foreground="{StaticResource Muted}"/></StackPanel></Border>
        </DockPanel>
      </Border>
      <GridSplitter Grid.Column="1" Grid.RowSpan="2" Width="5" HorizontalAlignment="Stretch" Background="{StaticResource Line}"/>
      <Border Grid.Column="2" Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,1,1" Padding="4,1">
        <Grid>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
            <TextBlock Text="Horizontal" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="5,0,8,0"/>
            <Button Style="{StaticResource ToolButton}" Content="−" ToolTip="Horizontal verkleinern" Click="ZoomOut_Click"/>
            <Button Style="{StaticResource ToolButton}" Content="+" ToolTip="Horizontal vergrößern" Click="ZoomIn_Click"/>
            <Button Style="{StaticResource ToolButton}" Content="R" ToolTip="Horizontaler Standard-Zoom (Einzeldatei: gesamte Länge)" Click="ResetHorizontalZoom_Click"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock Text="Vertikal" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="5,0,8,0"/>
            <Button Style="{StaticResource ToolButton}" Content="−" ToolTip="Vertikal verkleinern" Click="ZoomVerticalOut_Click"/>
            <Button Style="{StaticResource ToolButton}" Content="+" ToolTip="Vertikal vergrößern" Click="ZoomVerticalIn_Click"/>
            <Button Style="{StaticResource ToolButton}" Content="R" ToolTip="Vertikalen Zoom auf Standard zurücksetzen" Click="ResetVerticalZoom_Click"/>
          </StackPanel>
        </Grid>
      </Border>
      <Border x:Name="EditorPanel" Grid.Column="2" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="{StaticResource WaveSurface}" ClipToBounds="True">
        <DockPanel LastChildFill="True">
          <Border DockPanel.Dock="Top" Height="27" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <ItemsControl x:Name="DocumentTabs" Grid.Column="0" Margin="4,0">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Margin="0,0,3,0" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="{StaticResource Raised}">
                      <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource TabSelectButton}" Content="{Binding DisplayName}" Tag="{Binding}" Click="DocumentTab_Click" ToolTip="Dokument aktivieren"/>
                        <Button Style="{StaticResource TabCloseButton}" Content="✕" Tag="{Binding}" Click="DocumentTabClose_Click" ToolTip="Dokument schließen (Strg+W)"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock x:Name="ViewRangeText" Grid.Column="1" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" Margin="8,0" VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <local:WaveformView x:Name="Waveform" ContextMenu="{StaticResource WaveformContextMenu}" SelectionChanged="Waveform_SelectionChanged"/>
        </DockPanel>
      </Border>
      <Border x:Name="MultitrackPanel" Grid.Column="2" Visibility="Collapsed" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="{StaticResource WaveSurface}" ClipToBounds="True">
        <DockPanel>
          <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="8,5">
            <WrapPanel><TextBlock Foreground="{StaticResource Muted}" VerticalAlignment="Center" Text="TEMPO" Margin="4,0,4,0"/><TextBox x:Name="BpmText" Width="55" Margin="5,0" Text="120" LostFocus="Bpm_LostFocus"/><TextBlock Foreground="{StaticResource Muted}" VerticalAlignment="Center" Text="BPM · 4/4" Margin="4,0,18,0"/><Button Style="{StaticResource ClassicButton}" Content="Mixdown" Margin="6,0,0,0" Click="Mixdown_Click"/><Button Style="{StaticResource ClassicButton}" Content="Mixdown als WAV" Margin="6,0,0,0" Click="StreamingMixdown_Click"/><TextBlock x:Name="MultitrackInfo" Margin="18,0,0,0" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></WrapPanel>
          </Border>
          <ScrollViewer DockPanel.Dock="Top" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"><ItemsControl x:Name="MultitrackTracks" Margin="8">
            <ItemsControl.ItemTemplate><DataTemplate>
              <Border BorderBrush="{StaticResource Line}" BorderThickness="1" Background="{StaticResource Panel}" Margin="0,0,0,6" Padding="6" MouseLeftButtonUp="Track_Selected">
                <Grid MinWidth="980"><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="55"/><ColumnDefinition Width="55"/><ColumnDefinition Width="105"/><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0"><TextBox BorderThickness="0" Background="Transparent" Foreground="{StaticResource Text}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Foreground="{StaticResource Muted}" FontSize="11" Text="{Binding StartText, StringFormat=Start: {0}}"/></StackPanel>
                  <ToggleButton Grid.Column="1" Content="Stumm" IsChecked="{Binding Muted}" Click="TrackMute_Click" ToolTip="Diese Spur nicht wiedergeben"/>
                  <ToggleButton Grid.Column="2" Content="Solo" IsChecked="{Binding Solo}" Click="TrackSolo_Click" ToolTip="Nur diese Spur wiedergeben"/>
                  <StackPanel Grid.Column="3"><TextBlock FontSize="10" Foreground="{StaticResource Muted}" Text="LAUT"/><Slider Minimum="0" Maximum="2" Value="{Binding Gain}" TickFrequency="0.25" IsSnapToTickEnabled="False" ValueChanged="TrackGain_Changed" ToolTip="Lautstärke"/></StackPanel>
                  <StackPanel Grid.Column="4"><TextBlock FontSize="10" Foreground="{StaticResource Muted}" Text="PAN L/R"/><Slider Minimum="-1" Maximum="1" Value="{Binding Pan}" TickFrequency="0.25" IsSnapToTickEnabled="False" ValueChanged="TrackPan_Changed" ToolTip="Panorama"/></StackPanel>
                  <Canvas Grid.Column="5" MinWidth="430" Height="52" Margin="10,0,0,0" Background="#FF111D21" ClipToBounds="True" AllowDrop="True" DragOver="TrackLane_DragOver" Drop="TrackLane_Drop"><Border Canvas.Left="{Binding ClipLeft}" Width="{Binding ClipWidth}" Height="38" Margin="0,7" Background="{StaticResource AccentDark}" BorderBrush="{StaticResource Accent}" BorderThickness="1"><TextBlock Foreground="{StaticResource Text}" VerticalAlignment="Center" Margin="8,0" Text="{Binding ClipLabel}" TextTrimming="CharacterEllipsis"/></Border></Canvas>
                </Grid>
              </Border>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl></ScrollViewer>
          <local:SequencerView x:Name="Sequencer"/>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
