<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>WaveBenchPro</AssemblyName>
    <Product>WaveBench Pro</Product>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>
  <PropertyGroup>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="**\*.cs" Exclude="tests\**\*.cs;.tooling\**\*.cs;obj\**\*.cs;bin\**\*.cs" />
    <InternalsVisibleTo Include="WellenEditor.Tests" />
    <PackageReference Include="NAudio" Version="3.3.0" />
    <PackageReference Include="NAudio.Vst3" Version="3.3.0" />
    <PackageReference Include="NAudio.Lame" Version="2.1.0" />
    <PackageReference Include="NAudio.SoundFile" Version="3.3.0" />
    <PackageReference Include="org.sndfile.runtime.win-x64" Version="1.2.2" />
  </ItemGroup>
</Project>
