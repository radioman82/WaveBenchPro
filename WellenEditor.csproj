<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>WaveBenchPro</AssemblyName>
    <Product>WaveBench Pro</Product>
    <Version>0.3.0-beta.3</Version>
    <AssemblyVersion>0.3.0.0</AssemblyVersion>
    <FileVersion>0.3.0.0</FileVersion>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=/_/WaveBenchPro</PathMap>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>
  <PropertyGroup>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <PropertyGroup Condition="'$(BetaProfile)' == 'true'">
    <DefineConstants>$(DefineConstants);BETA_PROFILE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="**\*.cs" Exclude="tests\**\*.cs;benchmarks\**\*.cs;.tooling\**\*.cs;obj\**\*.cs;bin\**\*.cs" />
    <InternalsVisibleTo Include="WellenEditor.Tests" />
    <PackageReference Include="NAudio" Version="3.3.0" />
    <PackageReference Include="NAudio.Asio" Version="3.3.0" />
    <PackageReference Include="NAudio.Vst3" Version="3.3.0" />
    <PackageReference Include="NAudio.Lame" Version="2.1.0" />
    <PackageReference Include="NAudio.SoundFile" Version="3.3.0" />
    <PackageReference Include="org.sndfile.runtime.win-x64" Version="1.2.2" />
  </ItemGroup>
  <Target Name="PublishReplaceableWindowsCodecs" BeforeTargets="_ComputeFilesToBundle"
          Condition="'$(RuntimeIdentifier)' == 'win-x64' and '$(BetaProfile)' != 'true'">
    <ItemGroup>
      <!-- The runtime searched its bundle extraction directory ahead of codec sidecars. -->
      <ResolvedFileToPublish Update="@(ResolvedFileToPublish)"
          Condition="$([System.String]::Copy(';FLAC.dll;ogg.dll;opus.dll;vorbis.dll;vorbisenc.dll;vorbisfile.dll;sndfile.dll;mpg123.dll;out123.dll;syn123.dll;libmp3lame.dll;libmp3lame.64.dll;').Contains(';%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension);'))">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
          Condition="'%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'libmp3lame.32.dll'" />
    </ItemGroup>
  </Target>
  <Target Name="RemoveBetaNativeCodecs" BeforeTargets="_ComputeFilesToBundle" Condition="'$(BetaProfile)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
          Condition="$([System.String]::Copy(';FLAC.dll;ogg.dll;opus.dll;vorbis.dll;vorbisenc.dll;vorbisfile.dll;sndfile.dll;mpg123.dll;out123.dll;syn123.dll;libmp3lame.dll;libmp3lame.64.dll;libmp3lame.32.dll;').Contains(';%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension);'))" />
    </ItemGroup>
  </Target>
</Project>
